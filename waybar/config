{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 53,
    "spacing": 5,
    "margin-bottom": -11,
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/power",
        "custom/keyboard",
        "network",
        "custom/vpn",
        "pulseaudio",
        "custom/microphone",
        "backlight",
        "custom/bluetooth",
        "battery",
        "custom/weather",
        "custom/resources",
        "custom/clock"
    ],
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "custom/clock": {
        "exec": "python3 ~/.config/waybar/scripts/clock_calendar.py",
        "return-type": "json",
        "interval": 30,
        "min-length": 5,
        "max-length": 25,
        "on-click": "korganizer"
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 900,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/weather_menu.sh"
    },
    "custom/resources": {
        "exec": "~/.config/waybar/scripts/resource_status.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "on-click": "plasma-systemmonitor"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% {icon}",
        "tooltip-format": "{timeTo}",
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.config/waybar/scripts/power_menu.sh"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": "Power options",
        "on-click": "wlogout"
    },
    "custom/keyboard": {
        "exec": "~/.config/waybar/scripts/keyboard_layout.sh",
        "interval": 1,
        "tooltip": "Keyboard layout",
        "on-click": "~/.config/waybar/scripts/keyboard_layout.sh toggle"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}   {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Screen brightness: {percent}%",
        "on-click": "~/.config/waybar/scripts/brightness_menu.sh",
        "on-scroll-up": "brightnessctl -d intel_backlight set +1%",
        "on-scroll-down": "brightnessctl -d intel_backlight set 1%-",
        "reverse-scrolling": true
    },
    "network": {
        "align": 0.5,
        "justify": "center",
        "format-wifi": "",
        "format-ethernet": " {ifname}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "format-icons": ["", "", "", ""],
        "on-click": "~/.config/waybar/scripts/wifi_menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn.sh status",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/vpn.sh menu",
        "on-click-right": "~/.config/waybar/scripts/vpn.sh toggle"
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth_status.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/bluetooth_menu.sh"
    },
    "pulseaudio": {
        "scroll-step": 1,
        "max-volume": 150,
        "reverse-scrolling": true,
        "format": "{icon}     {volume}%",
        "format-bluetooth": "{icon}     {volume}%",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "   Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/microphone": {
        "exec": "~/.config/waybar/scripts/microphone_meter.py",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol --tab=4",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    }
}
