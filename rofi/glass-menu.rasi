@import "~/.config/rofi/colors.rasi"

* {
    font: "Inter 13";
    text-color: @fg-col;
    background-color: transparent;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 500px;
    border-radius: 30px;
    background-color: rgba(32, 30, 30, 0.70);
    border: 2px;
    border-color: rgba(183, 178, 185, 0.10);
}

mainbox {
    padding: 22px;
    spacing: 14px;
}

inputbar {
    padding: 12px 16px;
    border-radius: 22px;
    background-color: rgba(87, 69, 138, 0.40);
    border: 2px;
    border-color: rgba(183, 178, 185, 0.10);
    children: [ prompt, entry ];
}

prompt {
    padding: 0 10px 0 0;
    text-color: @fg-col;
}

entry {
    placeholder: "";
    text-color: @fg-col;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    spacing: 10px;
}

element {
    padding: 14px 18px;
    border-radius: 24px;
    background-color: rgba(87, 69, 138, 0.40);
    border: 2px;
    border-color: rgba(183, 178, 185, 0.10);
}

element selected normal,
element selected active,
element selected urgent {
    background-color: rgba(205, 169, 200, 0.70);
    border-color: #CDA9C8;
    text-color: #ffffff;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
